{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/refs/heads/dev/crates/tauri-config-schema/schema.json",
  "productName": "Aether 5.1.1 Codex-AGY",
  "version": "5.1.1",
  "identifier": "com.aether.desktop.codexagy",
  "build": {
    "beforeBuildCommand": "mkdir -p dist/dsp-wasm && cp index.html *.js *.svg dist/ && cp -R dsp-wasm/pkg dist/dsp-wasm/",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3456/desktop/index.html",
    "beforeDevCommand": "python3 -m http.server 3456 -d /Users/matt/.gemini/antigravity/scratch/aether"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Aether 5.1.1 Codex-AGY",
        "width": 1440,
        "height": 900,
        "resizable": false,
        "fullscreen": false,
        "dragDropEnabled": false,
        "maximized": false,
        "maximizable": false,
        "center": true,
        "minWidth": 1440,
        "maxWidth": 1440,
        "minHeight": 900,
        "maxHeight": 900
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../nodes/**/*",
      "../../default_library/**/*"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
