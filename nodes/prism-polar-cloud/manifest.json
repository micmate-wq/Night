{
  "id": "com.aether.node.prism-polar-cloud",
  "name": "Prism Polar Cloud",
  "version": "1.0.0",
  "author": "Aether Community",
  "category": "Generator / Ambient Drone",
  "description": "Generative harmonic chord cloud routed through a Reason Polar-inspired Doppler pitch-shifting cascade delay loop.",
  "inputs": 0,
  "outputs": 2,
  "entry": {
    "dsp": "dsp.js",
    "ui": "ui.html"
  },
  "parameters": [
    {
      "id": "chord",
      "name": "Harmonic Voicing",
      "type": "int",
      "min": 0,
      "max": 3,
      "default": 0,
      "unit": "chord"
    },
    {
      "id": "interval",
      "name": "Cascade Interval",
      "type": "int",
      "min": 0,
      "max": 4,
      "default": 0,
      "unit": "interval"
    },
    {
      "id": "density",
      "name": "Cloud Density",
      "type": "float",
      "min": 0.1,
      "max": 1.0,
      "default": 0.45,
      "step": 0.01,
      "unit": "norm"
    },
    {
      "id": "delayTime",
      "name": "Delay Time",
      "type": "float",
      "min": 0.2,
      "max": 1.0,
      "default": 0.42,
      "step": 0.01,
      "unit": "s"
    },
    {
      "id": "feedback",
      "name": "Feedback Amount",
      "type": "float",
      "min": 0.0,
      "max": 0.85,
      "default": 0.60,
      "step": 0.01,
      "unit": "norm"
    },
    {
      "id": "wash",
      "name": "Master Wash",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.65,
      "step": 0.01,
      "unit": "norm"
    },
    {
      "id": "rootPitch",
      "name": "Master Pitch",
      "type": "float",
      "min": -12.0,
      "max": 12.0,
      "default": 0.0,
      "step": 1.0,
      "unit": "st"
    },
    {
      "id": "swellRate",
      "name": "Breathing Speed",
      "type": "float",
      "min": 0.08,
      "max": 0.55,
      "default": 0.22,
      "step": 0.01,
      "unit": "Hz"
    },
    {
      "id": "gain",
      "name": "Master Gain",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.75,
      "step": 0.01,
      "unit": "norm"
    }
  ],
  "canvas_animation": "wobbly_shimmer"
}
