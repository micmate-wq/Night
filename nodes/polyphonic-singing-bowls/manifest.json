{
  "id": "com.aether.node.polyphonicsingingbowls",
  "name": "Polyphonic Singing Bowls",
  "version": "1.1.0",
  "author": "Aether DSP",
  "description": "5-voice generative Tibetan singing bowls with per-voice tone control, stochastic triggers, acoustic beating, and harmonic resonance.",
  "entry": {
    "ui": "ui.html",
    "dsp": "dsp.js"
  },
  "canvas_animation": "interference_wave",
  "parameters": [
    {
      "id": "rootPitch",
      "name": "Root Pitch (Hz)",
      "type": "float",
      "min": 60.0,
      "max": 300.0,
      "default": 120.0
    },
    {
      "id": "activity",
      "name": "Activity",
      "type": "float",
      "min": 0.05,
      "max": 1.0,
      "default": 0.5
    },
    {
      "id": "resonance",
      "name": "Resonance",
      "type": "float",
      "min": 0.1,
      "max": 1.0,
      "default": 0.7
    },
    {
      "id": "beatingMix",
      "name": "Beating Mix",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.6
    },
    {
      "id": "tone_1",
      "name": "Bowl 1 Tone",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.8
    },
    {
      "id": "tone_2",
      "name": "Bowl 2 Tone",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.8
    },
    {
      "id": "tone_3",
      "name": "Bowl 3 Tone",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.8
    },
    {
      "id": "tone_4",
      "name": "Bowl 4 Tone",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.8
    },
    {
      "id": "tone_5",
      "name": "Bowl 5 Tone",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.8
    }
  ]
}
