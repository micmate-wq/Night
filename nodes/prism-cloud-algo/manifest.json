{
  "id": "com.aether.node.prism-cloud-algo",
  "name": "Prism Cloud (Algorithmic)",
  "version": "1.1.0",
  "author": "Aether Community",
  "category": "Generator / Ambient Drone",
  "description": "High-frequency harmonic chord cloud with breathing LFO dynamics, master pitch transposition, and an algorithmic allpass wash reverb network.",
  "inputs": 0,
  "outputs": 2,
  "entry": {
    "dsp": "dsp.js",
    "ui": "ui.html"
  },
  "parameters": [
    {
      "id": "chord",
      "name": "Harmonic Voicing",
      "type": "int",
      "min": 0,
      "max": 3,
      "default": 0,
      "unit": "chord"
    },
    {
      "id": "rootPitch",
      "name": "Master Pitch",
      "type": "float",
      "min": -12.0,
      "max": 12.0,
      "default": 0.0,
      "step": 1.0,
      "unit": "st"
    },
    {
      "id": "density",
      "name": "Cloud Density",
      "type": "float",
      "min": 0.1,
      "max": 1.0,
      "default": 0.45,
      "step": 0.01,
      "unit": "norm"
    },
    {
      "id": "swellRate",
      "name": "Breathing Speed",
      "type": "float",
      "min": 0.08,
      "max": 0.55,
      "default": 0.22,
      "step": 0.01,
      "unit": "Hz"
    },
    {
      "id": "wash",
      "name": "Algo Wash Depth",
      "type": "float",
      "min": 0.0,
      "max": 0.95,
      "default": 0.72,
      "step": 0.01,
      "unit": "norm"
    },
    {
      "id": "attack",
      "name": "Grain Attack",
      "type": "float",
      "min": 0.4,
      "max": 3.0,
      "default": 1.2,
      "step": 0.05,
      "unit": "s"
    },
    {
      "id": "release",
      "name": "Grain Release",
      "type": "float",
      "min": 1.5,
      "max": 7.0,
      "default": 4.2,
      "step": 0.1,
      "unit": "s"
    },
    {
      "id": "gain",
      "name": "Master Gain",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.75,
      "step": 0.01,
      "unit": "norm"
    }
  ],
  "canvas_animation": "wobbly_shimmer"
}
