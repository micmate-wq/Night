{
  "id": "com.aether.node.tick-tok",
  "name": "Tick Tok",
  "version": "1.0.0",
  "author": "Aether",
  "description": "Weekend-wilder lockable rhythm: BPM 16th clock, morphing kick, talk snare. Same analog family as Tick.",
  "category": "Rhythm / Generator",
  "inputs": 0,
  "outputs": 2,
  "entry": {
    "dsp": "dsp.js",
    "ui": "ui.html"
  },
  "parameters": [
    {
      "id": "bpm",
      "name": "BPM",
      "type": "float",
      "min": 60,
      "max": 180,
      "default": 120,
      "unit": "bpm"
    },
    {
      "id": "pattern",
      "name": "Pattern",
      "type": "float",
      "min": 0,
      "max": 1,
      "default": 0.22,
      "unit": "norm"
    },
    {
      "id": "talk",
      "name": "Talk",
      "type": "float",
      "min": 0,
      "max": 1,
      "default": 0.62,
      "unit": "norm"
    },
    {
      "id": "decay",
      "name": "Decay",
      "type": "float",
      "min": 0,
      "max": 1,
      "default": 0.38,
      "unit": "norm"
    },
    {
      "id": "density",
      "name": "Density",
      "type": "float",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "unit": "norm"
    },
    {
      "id": "lock",
      "name": "Lock",
      "type": "float",
      "min": 0,
      "max": 1,
      "default": 0.7,
      "unit": "norm"
    },
    {
      "id": "color",
      "name": "Color",
      "type": "float",
      "min": 0,
      "max": 1,
      "default": 0.4,
      "unit": "norm"
    }
  ],
  "canvas_animation": "pulse"
}
