{
  "id": "com.aether.node.prism-sparkle",
  "name": "Prism Sparkle",
  "version": "1.1.0",
  "author": "Aether Community",
  "category": "Generator / High Spectrum",
  "description": "High-frequency modal FM synth and granular scatter engine with spatial shimmer delay.",
  "inputs": 0,
  "outputs": 2,
  "entry": {
    "dsp": "dsp.js",
    "ui": "ui.html"
  },
  "parameters": [
    {
      "id": "density",
      "name": "Scatter Density",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.4,
      "step": 0.01,
      "unit": "norm"
    },
    {
      "id": "scatter",
      "name": "Pitch Jitter",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.5,
      "step": 0.01,
      "unit": "norm"
    },
    {
      "id": "shimmer",
      "name": "Shimmer Decay",
      "type": "float",
      "min": 0.0,
      "max": 0.85,
      "default": 0.45,
      "step": 0.01,
      "unit": "norm"
    },
    {
      "id": "cutoff",
      "name": "HPF Cutoff",
      "type": "float",
      "min": 3000.0,
      "max": 16000.0,
      "default": 6500.0,
      "step": 100.0,
      "unit": "Hz"
    },
    {
      "id": "rootPitch",
      "name": "Root Pitch",
      "type": "float",
      "min": -12.0,
      "max": 12.0,
      "default": 0.0,
      "step": 1.0,
      "unit": "st"
    },
    {
      "id": "decay",
      "name": "Modal Decay",
      "type": "float",
      "min": 0.05,
      "max": 1.2,
      "default": 0.35,
      "step": 0.01,
      "unit": "s"
    },
    {
      "id": "scale",
      "name": "Scale Quantization",
      "type": "int",
      "min": 0,
      "max": 3,
      "default": 0,
      "unit": "mode"
    },
    {
      "id": "gain",
      "name": "Master Gain",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.7,
      "step": 0.01,
      "unit": "norm"
    }
  ],
  "canvas_animation": "prism_sparkle"
}
