{
  "id": "com.aether.node.singingbowl",
  "name": "Singing Bowl",
  "version": "1.0.0",
  "author": "Aether DSP",
  "description": "Generative Tibetan singing bowl drone using detuned additive synthesis and acoustic beating.",
  "entry": {
    "ui": "ui.html",
    "dsp": "dsp.js"
  },
  "canvas_animation": "pulse",
  "parameters": [
    {
      "id": "frequency",
      "name": "Base Frequency",
      "type": "float",
      "min": 80.0,
      "max": 400.0,
      "default": 140.0
    },
    {
      "id": "beating",
      "name": "Beating Rate (Hz)",
      "type": "float",
      "min": 0.1,
      "max": 4.0,
      "default": 1.5
    },
    {
      "id": "overtone",
      "name": "Overtone Mix",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.4
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.7
    }
  ]
}
