    {
      "id": "color",
      "name": "Color",
      "type": "float",
      "min": 0,
      "max": 1,
      "default": 0.4,
      "unit": "norm"
    },
    {
      "id": "mix",
      "name": "Mix",
      "type": "float",
      "min": 0,
      "max": 1,
      "default": 0.62,
      "unit": "norm"
