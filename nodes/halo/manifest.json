      "max": 1,
      "default": 0.12,
      "unit": "norm"
    },
    {
      "id": "zone",
      "name": "Zone",
      "type": "float",
      "min": 0,
      "max": 1,
      "default": 0,
      "unit": "norm"
    },
    {
