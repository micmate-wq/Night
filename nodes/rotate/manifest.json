    },
    {
      "id": "spread",
      "name": "Spread",
      "type": "float",
      "min": 0,
      "max": 1,
      "default": 0.45,
      "unit": "norm"
    },
    {
      "id": "morph",
      "name": "Morph",
      "type": "float",
      "min": 0,
      "max": 1,
      "default": 0.3,
      "unit": "norm"
    },
    {
      "id": "q",
      "name": "Q",
      "type": "float",
      "min": 0,
      "max": 1,
      "default": 0.62,
      "unit": "norm"
    }
  ],
  "canvas_animation": "pulse"
}
